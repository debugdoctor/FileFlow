FILEFLOW_HOST=0.0.0.0
FILEFLOW_PORT=5000
RUST_LOG=info

# Default chunks are 1MiB; advanced settings support up to 2MiB.
# Minimum chunk size is 256KiB; lower MAX_BLOCK_SIZE values are raised to 256KiB.
# MAX_BLOCKS_PER_FILE uses the default chunk size to derive the 10GiB file limit.
# MAX_BLOCK_SIZE=2097152
# MAX_BLOCKS_PER_FILE=10240
# RAM only: 256MiB shared budget, adaptive windows from 2MiB up to 32MiB.
# Waiting transfers get priority for their minimum window; idle shares are not reserved.
# Limits below 1MiB are raised to 1MiB; windows cannot exceed the global budget.
# MAX_CACHE_BYTES=268435456
# TRANSFER_WINDOW_BYTES=33554432
# TRANSFER_MIN_WINDOW_BYTES=2097152
# MAX_ACTIVE_HTTP_TRANSFERS=128
# Upload permits reserve bytes and one of four upload slots before sending data.
# Unused permits expire after 30 seconds; waiting demand expires after 30 seconds.
# Release each block after receiver acknowledgement. Clean up stalled transfers
# after 10 minutes without cache activity. No server temporary files are used.
# BLOCK_TTL_SECS=600

# P2P config (single values)
# STUN_SERVER=stun:stun.l.google.com:19302
# TURN_SERVER=turn:turn.example.com:3478
# TURN_USERNAME=example
# TURN_CREDENTIAL=example

# Docker Compose host port and container RAM limit (swap is disabled).
# FILEFLOW_HTTP_PORT=5000
# FILEFLOW_MEMORY_LIMIT=512m
# Optional LAN HTTPS overlay host port.
# FILEFLOW_HTTPS_PORT=443
